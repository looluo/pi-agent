{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-agent",
  "version": "0.3.0",
  "identifier": "com.pi.agent.desktop",
  "build": {
    "frontendDist": "../src-tauri/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pi Agent App",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
